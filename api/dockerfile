# syntax=docker/dockerfile:1

############################
# Builder stage
############################
FROM rust:1.95-bookworm AS builder

WORKDIR /app

# Install build dependencies (OpenSSL only if your crates need it)
RUN apt-get update && apt-get install -y pkg-config libssl-dev ca-certificates && rm -rf /var/lib/apt/lists/*

# Cache dependencies first
COPY api/Cargo.toml ./api/
COPY crates/pipeline-core/Cargo.toml ./crates/pipeline-core/Cargo.toml 

# Dummy files for dependency caching
RUN mkdir -p api/src crates/pipeline-core/src && \
    echo "fn main() {}" > api/src/main.rs && \
    echo "" > crates/pipeline-core/src/lib.rs

RUN cd api && cargo build --release

# Copy real source
COPY api ./api
COPY crates ./crates

RUN cd api && cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/api/target/release/seqworks-api /usr/local/bin/seqworks-api

EXPOSE 8000

CMD ["seqworks-api"]